# Google AI Studio key. Used first.
GEMINI_API_KEY=
# Optional override. Default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# xAI key for Grok. Used when Gemini is missing or fails.
XAI_API_KEY=
# Optional override. Default is grok-3.
XAI_MODEL=grok-3

# MongoDB Atlas connection string. Campaigns are stored here.
MONGODB_URI=
MONGODB_DB=hackathon
